# Copy to .env.local and fill in. Never commit real keys.
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-6.2-sol
ANTHROPIC_API_KEY=
FALLBACK_MODEL=claude-opus-5-5
CONTEXT_DEV_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_SPEND_CAP_USD=10
# Model reasoning effort: low | medium | high (default medium)
CHAT_EFFORT=
# Opens the chatbot in production without Turnstile/Upstash. Leave empty.
CHAT_FORCE_ENABLED=
ADMIN_EMAIL=
# TMDB_API_KEY is only for scripts/, never shipped to the client
TMDB_API_KEY=
# PostHog project API key (phc_..., public). Analytics are off when empty.
NEXT_PUBLIC_POSTHOG_KEY=
