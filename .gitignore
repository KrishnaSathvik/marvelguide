# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env (keep example)
!.env.example

# local tooling
/.playwright-mcp/


# Images and third-party reference material stay local: the site serves images from Supabase Storage.
# images/manifest.json is kept (scripts/import-images.mjs reads it to re-upload from a local images/ folder).
/images/*
!/images/manifest.json
/data/tmdb/img/
/assets/
/docs/reference/
/public/art/

# internal notes, never public
/AGENTS.md
/docs/planning/
